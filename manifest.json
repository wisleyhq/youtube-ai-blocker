{
  "manifest_version": 3,
  "name": "Bloqueador de Vídeos de IA para YouTube",
  "version": "1.3.0",
  "description": "Oculta ou desfoca no YouTube os vídeos com o selo oficial \"Criado com IA\" e bloqueia canais com muitos vídeos assim.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "src/defaults.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "src/defaults.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Bloqueador de Vídeos de IA"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bloqueador-ia-youtube@wisley.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
